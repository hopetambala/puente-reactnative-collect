# No trailing slash: `node_modules/` matches a DIRECTORY but not a SYMLINK,
# so a symlinked node_modules slips past `git add -A` and gets committed.
# Checking that branch out then REPLACES a real node_modules with a
# self-referential link and destroys the install. Happened 2026-08-29.
node_modules
coverage/
expo-resources/
.expo
.vscode
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
logs/

# macOS
.DS_Store*
.env*
scripts/dynamic-env/app.secrets.json
scripts/update-version/app.secrets.json
app.generated.json

# Virtual Env
#
reactenv/
scripts/update-version/app.secrets.json

# Stuff for release builds
# (e.g. for EAS)
environment.js
app.json

# Regenerated by `expo prebuild`; EAS excludes android/ via .easignore and
# prebuilds from app.json, so nothing in here is authoritative.
android/
# ios/

# AI
.claude/handoff
.claude/screenshots*

# Per-run logs from `yarn maestro:stability`. Note the trailing-slash lesson
# recorded in CLAUDE.md: a pattern ending in "/" matches a directory but NOT a
# symlink, which is how a node_modules symlink once got committed. No slash.
.maestro/.stability

